# Copy this file to .env and replace every <...> placeholder.
# Never commit the real .env file.

DATABASE_URL=postgresql://<database-user>:<database-password>@localhost:5432/FlashResult
PORT=3000

# Generate two different values with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=<at-least-32-character-secret>
AUTH_CACHE_SECRET=<different-at-least-32-character-secret>

JWT_ISSUER=flash-result-api
JWT_AUDIENCE=flash-result-student
JWT_EXPIRES_IN_SECONDS=900

REDIS_URL=redis://localhost:6379

# Global login-admission capacity. Reduce CAPACITY to 3 when manually testing.
ADMISSION_CAPACITY=100
ADMISSION_REFILL_PER_SECOND=100
ADMISSION_TICKET_TTL_SECONDS=60
ADMISSION_QUEUE_MAX_SIZE=1000
ADMISSION_REQUEST_TTL_SECONDS=120
ADMISSION_QUEUE_DRAIN_INTERVAL_MS=100

FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
