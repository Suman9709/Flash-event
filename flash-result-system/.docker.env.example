# Copy to .docker.env before running Docker Compose.
# Keep the real file local; it contains your database password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<choose-a-local-database-password>
POSTGRES_DB=FlashResult

# Point at the existing Docker volume that holds your student records. The
# PostgreSQL image major version must match the volume's PG_VERSION file.
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DATA_VOLUME=<existing-postgres-volume-name>

# Values used by API containers. `db` and `redis` are Docker service names,
# not localhost. Replace <same-password> with POSTGRES_PASSWORD above.
DOCKER_DATABASE_URL=postgresql://postgres:<same-password>@db:5432/FlashResult
DOCKER_REDIS_URL=redis://redis:6379
